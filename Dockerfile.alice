# ALICE — Artificial Lucid Intelligence for Cognitive Empathy.
#
# Conda base shared with Insult's Dockerfile (memory:
# feedback_no_pypi_only_conda). Same image, same channel order, same
# environment.yml — keeps both bots on one dependency tree so a
# pip-audit / bandit scan covers both at once and ACR layer cache
# kicks in on the second build of any given commit.
#
# Quay.io chosen over Docker Hub to avoid the anonymous-pull rate
# limit (same reason MCR replaced python:3.14-slim historically;
# memory: reference_dockerfile_base_mcr).
#
# Differences from Insult's image:
# - Only copies the `alice/` package + persona, not `insult/`. ALICE
#   doesn't import from Insult at runtime (the bridge goes the other
#   way: Insult → ALICE via REST).
# - Exposes port 8788 for the FastAPI /invite endpoint that Insult
#   calls. Insult's container does NOT expose anything (Discord-only).
# - Entrypoint runs `python -m alice run` which boots Discord + the
#   FastAPI server in the same asyncio loop.

FROM quay.io/condaforge/miniforge3:26.1.1-3

SHELL ["/bin/bash", "-l", "-c"]
WORKDIR /app

# Same env install pattern as the Insult Dockerfile. The environment.yml
# is shared so both images pin identical versions.
COPY environment.yml .
RUN mamba env update -n base -f environment.yml \
 && mamba clean --all --yes \
 && find /opt/conda/ -follow -type f -name '*.a' -delete \
 && find /opt/conda/ -follow -type f -name '*.pyc' -delete

# ALICE's LLM path runs through fi_runner.CodexBackend, which shells out to the
# `codex` CLI pointed at the shared Azure OpenAI endpoint (no ChatGPT login —
# just the Azure key bridged into AZURE_OPENAI_API_KEY at runtime). codex is an
# npm binary, so add Node.js to the conda base and install it globally. This is
# an ALICE-only layer: Insult's image runs ClaudeCodeBackend and skips it, so it
# stays out of the shared environment.yml.
RUN mamba install -n base -y nodejs \
 && npm i -g @openai/codex \
 && mamba clean --all --yes \
 && find /opt/conda/ -follow -type f -name '*.pyc' -delete

# Copy ALICE's code + persona AND the shared/ package. Since v3.9.8
# `alice/__main__.py` and `alice/cogs/chat.py` import from `shared.*`
# (logging_setup, text chunking, llm retry). Insult's code is NOT
# copied — the bridge between bots is REST, not a Python import.
COPY alice/ alice/
COPY shared/ shared/

# Expose the /invite endpoint port. Discord traffic uses outbound only,
# so we don't EXPOSE for that.
EXPOSE 8788

CMD ["python", "-m", "alice", "run"]
