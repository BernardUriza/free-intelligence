# ALICE — Artificial Lucid Intelligence for Cognitive Empathy.
#
# Same base image as Insult (MCR Python 3.14 bookworm) for two reasons:
# 1. ACR layer cache reuse — the OS + Python install layer is identical
#    so the first ALICE build after an Insult build is fast.
# 2. Operational parity — when something breaks at the runtime layer
#    (TLS cert, glibc, asyncpg wheel), the fix lives in one Dockerfile,
#    not two. MCR avoids the Docker Hub anonymous-pull rate limit that
#    bit us on 2026-05-05 (see Insult's Dockerfile comment).
#
# Differences from Insult's image:
# - Only copies the `alice/` package + persona, not `insult/`. ALICE
#   doesn't import from Insult at runtime (the bridge goes the other
#   way: Insult → ALICE via REST).
# - Exposes port 8788 for the FastAPI /invite endpoint that Insult
#   calls. Insult's container does NOT expose anything (Discord-only).
# - Entrypoint runs `python -m alice run` which boots Discord + the
#   FastAPI server in the same asyncio loop.

FROM mcr.microsoft.com/devcontainers/python:3.14-bookworm

WORKDIR /app

# Install Python deps (cached layer). Reuses the shared requirements.txt
# because both bots share asyncpg, structlog, discord.py, etc. The OpenAI
# SDK is already declared there for voice. Adding alice-specific deps
# (fastapi, uvicorn, httpx) at the requirements.txt level rather than a
# separate file keeps both images on the same dependency tree, so a
# Snyk/pip-audit scan covers both bots at once.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy only ALICE's code + persona — keeps the image smaller and makes
# Insult-side changes not invalidate ALICE's cache layer. The persona
# file lives inside alice/ (alice/persona.md), so this single COPY
# brings everything ALICE needs at runtime.
COPY alice/ alice/

# Expose the /invite endpoint port. Discord traffic uses outbound only,
# so we don't EXPOSE for that.
EXPOSE 8788

CMD ["python", "-m", "alice", "run"]
