# Backend: se REUSA el server de og118 (apps/og118/server), levantado en otro
# puerto y con FI_PERSONA_PATH apuntando a la persona de Fénix. No hay un
# servidor propio: duplicarlo sería reinventar lo canónico.
NEXT_PUBLIC_FENIX_API=http://localhost:8119

# El corpus de la papelería va PRECARGADO: aquí no hay selector de proyecto que
# el equipo pueda olvidar. Se crea con:
#   curl -X POST $API/projects -d '{"name":"Papelería Fénix — lista maestra"}'
#   curl -X POST $API/projects/<id>/upload -F file=@lista-maestra.md
NEXT_PUBLIC_FENIX_CORPUS=project-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
