# og118 web — configuración PÚBLICA (NEXT_PUBLIC_*), horneada en el bundle al
# construir. Nada secreto vive aquí: el SPA client_id de Auth0 va embebido por
# diseño (PKCE, sin secret) y el token de acceso se escribe en el navegador en
# runtime, nunca en el build.
#
# Copia este archivo a `.env.local` para desarrollo. Los valores de staging/prod
# se pasan en el `env:` del paso "Build static export" de
# .github/workflows/og118-web-staging.yml.

# Backend FastAPI (fi-runner). Sin ella el cliente pega a http://localhost:8118.
NEXT_PUBLIC_OG118_API=http://localhost:8118

# `auth0` | `bearer`. auth0 es lo que corre en staging/prod y lo canónico para
# local — NO lo cambies a bearer para saltarte el login: cambia la app entera
# (ver .claude/rules/local-dev-auth-mode-parity.md).
NEXT_PUBLIC_OG118_AUTH_MODE=auth0
NEXT_PUBLIC_AUTH0_DOMAIN=dev-1r4daup7ofj7q6gn.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=9FxTpqyKHP9xw9u4fO6T3Ob7acAarEQj
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.og118.ai

# Proyectos (workspaces con corpus de documentos) — APAGADO por default.
# Acepta 1 | true | yes | on, igual que el `OG118_PROYECTOS` del server, y se
# prende junto con él: prender sólo el web deja una UI pegándole a 404s.
# Qué quita exactamente: ../DEPLOY.md § NEXT_PUBLIC_OG118_PROYECTOS
# NEXT_PUBLIC_OG118_PROYECTOS=1
