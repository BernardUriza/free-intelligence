# Discord
DISCORD_TOKEN=your_bot_token_here
COMMAND_PREFIX=!

# Anthropic Claude API (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-your_api_key_here

# LLM Config
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=5
SYSTEM_PROMPT=You are a helpful assistant.

# Model Router (3-tier: casual/depth/crisis). See .claude/plans/model_router.md.
# When MODEL_ROUTER_ENABLED=true, LLM_MODEL above is the "depth" tier.
MODEL_ROUTER_ENABLED=false
CASUAL_MODEL=claude-haiku-4-5-20251001
CRISIS_MODEL=claude-opus-4-7
OPUS_24H_CAP=20

# Memory
MEMORY_RECENT_LIMIT=50
MEMORY_RELEVANT_LIMIT=5

# Azure Blob Storage (optional — for DB persistence)
# Get from: Azure Portal → Storage Account → Access Keys
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# Debug HTTP server (read-only introspection of bot state)
# If DEBUG_TOKEN is empty, the server does NOT start (fail-closed).
# Generate a random token: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# DEBUG_TOKEN=
# DEBUG_HOST=0.0.0.0
# DEBUG_PORT=8787

# AIRE door — the ONLY LLM transport left in this repo (persona_runner's turns
# and judges, and demux_ai.host_llm since the 2026-08-29 AIREBackend
# consolidation). Both are required or every agentic turn raises
# "AIRE door not configured".
# AIRE_GATE_URL=https://aire.example/
# AIRE_AUTH_TOKEN=
# Host router (demux_ai/host_llm.py) — its own AIRE casita and model, kept
# apart from every persona's so a routing turn can never rewrite a persona's
# living CLAUDE.md. Defaults: demux / haiku.
# HOST_ROUTER_PROJECT=demux
# HOST_ROUTER_MODEL=haiku

# Seudónimo de auditoría de la banda de crisis (issue #54).
# Llave del HMAC que convierte el user_id de Discord en un código que AGRUPA
# pero no identifica. VACÍA = los eventos de banda salen sin seudónimo; nunca
# se cae a un hash sin llave, porque un sha256 pelón del user_id de Discord es
# reversible (el espacio de IDs del servidor es chico y conocido).
# Rota cada mes por diseño: el mes va dentro del HMAC y visible al frente del
# código, así que dos meses no se pueden comparar ni queriendo.
# Genera una llave: python -c "import secrets; print(secrets.token_urlsafe(32))"
# CRISIS_AUDIT_KEY=
