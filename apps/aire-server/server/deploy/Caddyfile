# AIRE — the LLM door's public face. Caddy terminates TLS (Let's Encrypt,
# auto-renewed) on 443 and proxies to the engine on loopback. This is the ONLY
# port the AIRE door is reachable on from the internet: the Bearer token never
# crosses a plaintext hop. The device listener (9099) stays plain HTTP by design
# (device reports, [[device-verb-protocol]]) — Caddy fronts the LLM door only.
#
# The door lives at gate.bernarduriza.com; the human-facing front owns the clean
# aire.bernarduriza.com (a CNAME to Azure Container Apps, its own managed cert).
{
	email bernarduriza@gmail.com
}

gate.bernarduriza.com {
	# The nickname generator (backlog #32) is its own process on 8090 so the
	# engine never pays the model's memory. Same Bearer secrets, checked inside
	# that app — the front proxies with its token, so the browser never holds one.
	handle /nickname* {
		reverse_proxy 127.0.0.1:8090
	}
	handle {
		reverse_proxy 127.0.0.1:8088
	}
}
