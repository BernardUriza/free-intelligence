# --- arbor-tts configuration ---

# ChatGPT GPT that ECHOES the user's text. synthesize() only works on ASSISTANT
# messages (user messages return 403), so we need a GPT whose reply == our text.
# Default: the "Mirror Emoji" GPT (echoes text + 16 emojis; emojis are NOT vocalized).
# For guaranteed-verbatim output, create a clean echo GPT (see README) and put its URL here.
CHATGPT_GPT_URL=https://chatgpt.com/g/g-6848ada1ac0c819191805e07a5664790-mirror-emoji

# Voice: accepts a DISPLAY name (arbor, cove, ember, ...) or a raw internal id (fathom, ...).
# "arbor" resolves to the internal id "fathom". See voices table in README.
ARBOR_VOICE=arbor

# Output audio format: mp3 | aac | opus  (wav returns 422 — not supported)
ARBOR_FORMAT=mp3

# Playwright storage state produced by `npm run login`
AUTH_STATE=./auth/state.json

# Run the browser headless (1) or visible for debugging (0)
HEADLESS=1

# HTTP server port
PORT=8799

# Maximum text accepted by the HTTP API. The Discord integration also clips to
# 4096 characters before calling the service.
MAX_TEXT_CHARS=4096

# Optional shared secret. If set, POST /tts requires `Authorization: Bearer <SERVICE_TOKEN>`.
# Production default is fail-closed: with REQUIRE_SERVICE_TOKEN=1, /tts will
# refuse to run unless SERVICE_TOKEN is set.
REQUIRE_SERVICE_TOKEN=1
SERVICE_TOKEN=

# Emergency kill switch. Set to 0 and restart to make /tts return 503.
TTS_ENABLED=1

# Personal-use abuse/cost guardrails. Set any cap to 0 to disable that cap.
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=20
DAILY_REQUEST_CAP=100
DAILY_TEXT_CHAR_CAP=100000

# Optional callback delivery allowlist. Empty = callbacks disabled.
# Supports exact hosts and wildcard suffixes like *.azurecontainerapps.io.
CALLBACK_ALLOWLIST=
