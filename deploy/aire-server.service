[Unit]
Description=AIRE server — the engine's HTTP surface (SSR + SSE, port 8088)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/aire
Environment=AIRE_ISOLATE_CONFIG=1
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/etc/aire/env
ExecStart=/opt/aire/.venv/bin/uvicorn aire.server:app --host 0.0.0.0 --port 8088
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
