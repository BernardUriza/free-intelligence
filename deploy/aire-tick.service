# The pen's heartbeat: one TICK line to the listener, which appends it to the
# log and the pen mirrors it to Postgres — a 5-minute proof the whole write
# path is alive. Loopback: exempt from rate limit and whitelist by design.
[Unit]
Description=AIRE tick — write one heartbeat line through the listener
After=aire-listener.service
Requires=aire-listener.service

[Service]
Type=oneshot
# chr(10) instead of a backslash-n literal: systemd C-unescapes "\n" inside
# quoted ExecStart strings into a real newline, breaking the python source.
ExecStart=/usr/bin/python3 -c "import socket; s = socket.create_connection(('127.0.0.1', 9099), 5); s.sendall(('TICK pen-heartbeat' + chr(10)).encode()); s.close()"
