#!/usr/bin/env bash
# Pre-commit hook for discord-bot:
# 1. Auto-sync persona.md capabilities from code
# 2. Ruff lint gate on staged Python files (matches CI)
# 3. Ruff format check gate on staged Python files (matches CI)
# 4. requirements.txt resolver check when staged (catches duplicate deps)
# 5. Version bump enforcement (at least one of the 3 version files must change)
#
# Why this hook exists:
# - 2026-05-19: two consecutive CI breaks both shipped to main because
#   nothing local caught them. First was 7 files needing ruff format,
#   second was fi-core declared twice in requirements.txt from different
#   branches. Both broke CI, both broke CD, both stalled the runner on
#   an old sha for hours. This hook would have blocked both.
# - All bypasses are explicit (--no-verify), so emergencies still work.

set -e

# Pick ruff: prefer .venv (matches CI version 0.11.12) over PATH ruff.
if [ -x .venv/bin/ruff ]; then
    RUFF=.venv/bin/ruff
elif command -v ruff >/dev/null; then
    RUFF=ruff
    echo "pre-commit WARN: using PATH ruff; .venv/bin/ruff (CI version) recommended"
fi

# --- Step 1: Auto-sync capabilities ---
PYTHON=${PYTHON:-python3}
[ -x .venv/bin/python ] && PYTHON=.venv/bin/python
$PYTHON scripts/sync_capabilities.py 2>/dev/null
if git diff --name-only | grep -q "persona.md"; then
    git add persona.md
    echo "pre-commit: persona.md capabilities auto-synced"
fi

# --- Step 2: Ruff lint + format gate on staged python files ---
staged_py=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
if [ -n "$staged_py" ] && [ -n "$RUFF" ]; then
    if ! echo "$staged_py" | xargs $RUFF check --quiet; then
        echo ""
        echo "ERROR: ruff check failed on staged files."
        echo "  Fix:   $RUFF check --fix \$(git diff --cached --name-only --diff-filter=ACM | grep .py)"
        echo "  Skip:  git commit --no-verify  (emergencies only)"
        exit 1
    fi
    if ! echo "$staged_py" | xargs $RUFF format --check --quiet; then
        echo ""
        echo "ERROR: ruff format check failed on staged files."
        echo "  Fix:   $RUFF format \$(git diff --cached --name-only --diff-filter=ACM | grep .py)"
        echo "  Skip:  git commit --no-verify  (emergencies only)"
        exit 1
    fi
fi

# --- Step 3: requirements.txt resolver check when staged ---
# Cheap defense: when requirements.txt changes, make sure no package is
# declared twice (most common failure mode — what bit us 2026-05-19 with
# fi-core@main + fi-core@dev). Doesn't catch deeper resolver conflicts.
if echo "$(git diff --cached --name-only)" | grep -q "^requirements.txt$"; then
    dup=$(grep -v '^#\|^$' requirements.txt | awk '{print tolower($1)}' \
        | sed -E 's/[<>=!~ ].*//;s/@.*//' | sort | uniq -d || true)
    if [ -n "$dup" ]; then
        echo ""
        echo "ERROR: requirements.txt declares the same package twice:"
        echo "$dup" | sed 's/^/  - /'
        echo "  Pip's resolver will fail in CI. Consolidate to one entry per package."
        exit 1
    fi
fi

# --- Step 4: Version bump enforcement ---
VERSION_FILES=(
    "pyproject.toml"
    "insult/__init__.py"
    "insult/core/delivery.py"
)
staged=$(git diff --cached --name-only)
for f in "${VERSION_FILES[@]}"; do
    if echo "$staged" | grep -q "^${f}$"; then
        exit 0
    fi
done

echo ""
echo "ERROR: Version bump required!"
echo "None of these files were modified:"
echo "  - pyproject.toml          (version = \"X.Y.Z\")"
echo "  - insult/__init__.py      (__version__ = \"X.Y.Z\")"
echo "  - insult/core/delivery.py (VERSION_TAG = \"ᵛX·Y·Z\")"
echo ""
echo "Bump all 3 before committing. Use --no-verify to skip (emergencies only)."
exit 1
